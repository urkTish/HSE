{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canada/knowledge-base/schema/market-observation.schema.json",
  "title": "attributes of a `re` record (SPEC §2.5, §6)",
  "type": "object",
  "required": ["metric", "value", "unit", "period", "geography_level", "figure_kind"],
  "additionalProperties": false,
  "properties": {
    "metric": {
      "type": "string",
      "enum": ["benchmark_price", "average_price", "median_price", "average_rent", "median_rent", "asking_rent", "vacancy_rate", "months_of_inventory", "sales_to_new_listings_ratio", "price_per_sqft", "rent_to_income_ratio", "other"]
    },
    "property_type": {
      "type": ["string", "null"],
      "enum": ["all", "detached", "semi_detached", "townhouse", "apartment_condo", "purpose_built_rental", "other", null]
    },
    "bedrooms": { "type": ["string", "null"], "enum": ["studio", "1", "2", "3+", "all", null] },
    "value": { "type": "number" },
    "unit": { "type": "string", "enum": ["cad", "cad_per_month", "cad_per_sqft", "percent", "months", "ratio"] },
    "period": { "type": "string", "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])|-Q[1-4])?$" },
    "geography_level": { "type": "string", "enum": ["national", "province", "cma", "city", "neighbourhood", "zone"] },
    "geography_name": { "type": ["string", "null"] },
    "figure_kind": { "type": "string", "enum": ["transaction", "survey", "asking", "index", "estimate"] },
    "sample_size": { "type": ["integer", "null"] },
    "year_over_year_change_pct": { "type": ["number", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
