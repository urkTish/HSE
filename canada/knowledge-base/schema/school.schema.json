{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canada/knowledge-base/schema/school.schema.json",
  "title": "attributes of a `school` record (SPEC §2.5, §7)",
  "type": "object",
  "required": ["website", "models", "legal_status", "qualifying", "qualifying_reason"],
  "additionalProperties": false,
  "properties": {
    "website": { "type": "string", "pattern": "^https?://" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["montessori", "waldorf_steiner", "reggio_inspired", "democratic", "sudbury", "self_directed", "agile_learning_centre", "project_based", "experiential_outdoor", "forest_school", "homeschool_support", "distributed_learning", "distance_learning", "online", "hybrid", "international_alternative", "other_innovative"]
      }
    },
    "philosophy": { "type": ["string", "null"] },
    "legal_status": {
      "type": "object",
      "required": ["label", "authority"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "province_category": { "type": ["string", "null"] },
        "authority": { "type": "string", "minLength": 1 },
        "registered": { "type": ["boolean", "null"] },
        "publicly_funded": { "type": ["boolean", "null"] },
        "inspected": { "type": ["boolean", "null"] },
        "can_issue_provincial_diploma": { "type": ["boolean", "null"] },
        "source_url": { "type": ["string", "null"] }
      }
    },
    "institution_type": {
      "type": ["string", "null"],
      "enum": ["independent_private_school", "registered_private_school", "homeschooling_provider", "educational_support_organisation", "online_private_school", null]
    },
    "ages": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": ["integer", "null"] },
        "max": { "type": ["integer", "null"] }
      }
    },
    "grades": { "type": ["string", "null"] },
    "language_of_instruction": { "type": "array", "items": { "type": "string" } },
    "curriculum": { "type": ["string", "null"] },
    "qualifications_offered": { "type": ["string", "null"] },
    "accreditation": { "type": "array", "items": { "type": "string" } },
    "tuition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "amount_cad_min": { "type": ["number", "null"] },
        "amount_cad_max": { "type": ["number", "null"] },
        "period": { "type": "string", "enum": ["year", "month", "term", "course", "other"] },
        "school_year": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{4}$" },
        "notes": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"] }
      }
    },
    "additional_fees": { "type": ["string", "null"] },
    "admission": { "type": ["string", "null"] },
    "class_size": { "type": ["string", "null"] },
    "boarding": { "type": ["boolean", "null"] },
    "transportation": { "type": ["string", "null"] },
    "campuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "address": { "type": ["string", "null"] },
          "lat": { "type": ["number", "null"] },
          "lon": { "type": ["number", "null"] },
          "coord_precision": { "type": "string", "enum": ["exact", "approximate", "centroid", "unknown"] }
        }
      }
    },
    "media_links": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } },
    "advantages": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "nearby_cities_km": { "type": ["object", "null"] },
    "qualifying": { "type": "string", "enum": ["qualifying", "unverified_candidate", "excluded"] },
    "qualifying_reason": { "type": "string", "minLength": 1 }
  }
}
