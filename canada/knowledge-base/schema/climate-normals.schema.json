{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-base/schema/climate-normals.schema.json",
  "title": "attributes of a `clim` record (SPEC §2.5, §8 B)",
  "type": "object",
  "required": ["station_name", "climate_id", "normals_period", "months", "annual"],
  "additionalProperties": false,
  "properties": {
    "station_name": { "type": "string", "minLength": 1 },
    "climate_id": { "type": "string", "pattern": "^[0-9A-Z]{7}$" },
    "station_id": { "type": ["integer", "null"] },
    "wmo_id": { "type": ["string", "null"] },
    "station_lat": { "type": ["number", "null"] },
    "station_lon": { "type": ["number", "null"] },
    "elevation_m": { "type": ["number", "null"] },
    "distance_to_city_centre_km": { "type": ["number", "null"] },
    "normals_period": { "type": "string", "enum": ["1991-2020", "1981-2010", "1971-2000"] },
    "months": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["month", "tmax_c", "tmin_c", "precip_mm"],
        "additionalProperties": false,
        "properties": {
          "month": { "type": "integer", "minimum": 1, "maximum": 12 },
          "tmax_c": { "type": ["number", "null"] },
          "tmin_c": { "type": ["number", "null"] },
          "tmean_c": { "type": ["number", "null"] },
          "precip_mm": { "type": ["number", "null"] },
          "rain_mm": { "type": ["number", "null"] },
          "snow_cm": { "type": ["number", "null"] },
          "sunshine_h": { "type": ["number", "null"] },
          "days_precip_ge_0_2mm": { "type": ["number", "null"] },
          "days_snow_ge_0_2cm": { "type": ["number", "null"] },
          "snow_depth_end_month_cm": { "type": ["number", "null"] },
          "humidity_pct_1500lst": { "type": ["number", "null"] },
          "wind_speed_kmh": { "type": ["number", "null"] },
          "daylight_h_computed": { "type": ["number", "null"] }
        }
      }
    },
    "annual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tmean_c": { "type": ["number", "null"] },
        "precip_mm": { "type": ["number", "null"] },
        "rain_mm": { "type": ["number", "null"] },
        "snow_cm": { "type": ["number", "null"] },
        "sunshine_h": { "type": ["number", "null"] },
        "days_tmax_gt_30c": { "type": ["number", "null"] },
        "days_tmin_lt_minus20c": { "type": ["number", "null"] },
        "days_snow_depth_ge_1cm": { "type": ["number", "null"] },
        "frost_free_days": { "type": ["number", "null"] }
      }
    },
    "extremes": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "record_high_c": { "type": ["number", "null"] },
        "record_high_date": { "type": ["string", "null"] },
        "record_low_c": { "type": ["number", "null"] },
        "record_low_date": { "type": ["string", "null"] }
      }
    },
    "phenomena": { "type": "array", "items": { "type": "string" } },
    "seasonal_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "winter": { "type": "string" },
        "spring": { "type": "string" },
        "summer": { "type": "string" },
        "autumn": { "type": "string" }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
