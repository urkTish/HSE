{
  "$comment": "The twelve information layers of SPEC §9 C. Shared by scripts/build-data.mjs and the app. A record joins the first layer whose categories include its category and whose subcategoryPattern (if any) matches its subcategory. shape and minzoom follow design/components.md §2 (Agent 06); cities use tiers instead of one minzoom (tier 1 always, tier 2 from z5, tier 3 from z7).",
  "layers": [
    {
      "id": "cities",
      "n": 1,
      "label": "Cities and towns",
      "categories": [
        "city"
      ],
      "kind": "points",
      "defaultOn": true,
      "colorToken": "--ce-layer-settlement",
      "shape": "circle",
      "minzoom": 0,
      "emptyNote": "No city records loaded."
    },
    {
      "id": "neighbourhoods",
      "n": 2,
      "label": "Neighbourhoods",
      "categories": [
        "nbhd"
      ],
      "kind": "points",
      "defaultOn": false,
      "colorToken": "--ce-layer-settlement",
      "shape": "ring",
      "minzoom": 10,
      "emptyNote": "No neighbourhood records yet. Neighbourhood geography is planned for Phase 2."
    },
    {
      "id": "physical",
      "n": 3,
      "label": "Physical geography and terrain",
      "categories": [
        "region",
        "landform"
      ],
      "kind": "points",
      "defaultOn": false,
      "colorToken": "--ce-layer-terrain-ink",
      "shape": "triangle-outline",
      "minzoom": 5,
      "emptyNote": "No region or landform records yet (Agent 04)."
    },
    {
      "id": "elevation",
      "n": 4,
      "label": "Elevation and topography",
      "categories": [],
      "kind": "relief",
      "defaultOn": false,
      "colorToken": "--ce-layer-terrain-ink",
      "shape": null,
      "minzoom": 0,
      "emptyNote": "Country-scale shaded relief (Natural Earth II, zoom 6 and below). Detailed NRCan elevation is planned for Phase 2."
    },
    {
      "id": "climate",
      "n": 5,
      "label": "Climate regions and climate information",
      "categories": [
        "clim",
        "hazard"
      ],
      "kind": "points",
      "defaultOn": false,
      "colorToken": "--ce-layer-climate",
      "shape": "ring-dot",
      "minzoom": 4,
      "emptyNote": "No climate-normals or hazard records yet (Agent 04)."
    },
    {
      "id": "real-estate",
      "n": 6,
      "label": "Real estate",
      "categories": [
        "re"
      ],
      "kind": "points",
      "defaultOn": false,
      "colorToken": "--ce-layer-housing",
      "shape": "tag",
      "minzoom": 6,
      "emptyNote": "No market observations yet (Agent 02). Prices and rents will be fetched on demand, never stored in the map."
    },
    {
      "id": "schools",
      "n": 7,
      "label": "Verified alternative private schools",
      "categories": [
        "school"
      ],
      "kind": "points",
      "defaultOn": false,
      "colorToken": "--ce-layer-education",
      "shape": "diamond",
      "minzoom": 0,
      "emptyNote": "No qualifying schools yet (Agent 03). Only schools verified as qualifying are ever shown."
    },
    {
      "id": "parks",
      "n": 8,
      "label": "National and provincial parks",
      "categories": [
        "park"
      ],
      "kind": "points",
      "defaultOn": false,
      "colorToken": "--ce-layer-nature",
      "shape": "hexagon",
      "minzoom": 4,
      "emptyNote": "No park records yet (Agent 04)."
    },
    {
      "id": "trails",
      "n": 9,
      "label": "Hiking trails",
      "categories": [
        "trail"
      ],
      "kind": "points",
      "defaultOn": false,
      "colorToken": "--ce-layer-nature",
      "shape": "triangle-down",
      "minzoom": 9,
      "emptyNote": "No trail records yet (Agent 04)."
    },
    {
      "id": "natural",
      "n": 10,
      "label": "Natural attractions",
      "categories": [
        "attr"
      ],
      "subcategoryPattern": "natur|lake|river|waterfall|falls|mountain|peak|glacier|beach|coast|canyon|gorge|forest|island|hot spring|scenic|viewpoint|wildlife",
      "kind": "points",
      "defaultOn": false,
      "colorToken": "--ce-layer-nature",
      "shape": "triangle",
      "minzoom": 5,
      "emptyNote": "No natural-attraction records yet (Agent 04)."
    },
    {
      "id": "tourism",
      "n": 11,
      "label": "Tourism and historical attractions",
      "categories": [
        "attr"
      ],
      "kind": "points",
      "defaultOn": false,
      "colorToken": "--ce-layer-heritage",
      "shape": "pentagon",
      "minzoom": 6,
      "emptyNote": "No tourism or historical-attraction records yet (Agent 04)."
    },
    {
      "id": "transport",
      "n": 12,
      "label": "Transportation and infrastructure",
      "categories": [
        "route",
        "service"
      ],
      "kind": "points+basemap",
      "defaultOn": true,
      "colorToken": "--ce-layer-transport",
      "shape": "square",
      "minzoom": 4,
      "emptyNote": "No route or service records yet. Roads, railways and airports shown come from the OpenStreetMap base map."
    }
  ],
  "categoryLabels": {
    "city": "City or town",
    "nbhd": "Neighbourhood",
    "region": "Region",
    "landform": "Landform",
    "clim": "Climate normals",
    "school": "School",
    "park": "Park",
    "trail": "Trail",
    "attr": "Attraction",
    "re": "Real-estate observation",
    "nat": "National rule or programme",
    "hazard": "Hazard",
    "route": "Route",
    "service": "Service"
  }
}
