# Production settings for the Oracle Cloud + Cloudflare Tunnel server (deploy/oracle/GUIDE.md).
#
# setup.sh copies this file to /opt/hse/.env (mode 600, root only) and fills in the empty secrets
# below with random values generated ON THE SERVER. Never commit the filled-in file and never put
# real values in this template. Re-running setup.sh keeps every value already in /opt/hse/.env.
# After editing /opt/hse/.env by hand, apply it with: sudo bash /opt/hse/deploy/oracle/update.sh

# --- How docker compose runs on the server (do not change) ---
COMPOSE_PROJECT_NAME=hse
COMPOSE_FILE=docker-compose.yml:deploy/oracle/docker-compose.prod.yml
# `tunnel` starts cloudflared (setup.sh --no-tunnel leaves it out, testing only); `clamav` starts
# the virus scanner.
COMPOSE_PROFILES=tunnel,clamav

# --- Address and tunnel (asked by setup.sh) ---
# The public web address without https://, e.g. hse.example.com. Used for emailed links.
HSE_HOSTNAME=
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> the token from the install command.
TUNNEL_TOKEN=
# The first administrator's email (also the only address allowed to delete projects).
ADMIN_EMAIL=

# --- Database (generated) ---
POSTGRES_USER=hse
POSTGRES_PASSWORD=
POSTGRES_DB=hse

# --- Secrets (generated, >= 32 characters each). Changing FIELD_ENCRYPTION_KEY or BLIND_INDEX_KEY
# later makes the stored ID numbers unreadable, so keep them with the backups (backup.sh does). ---
ENVIRONMENT=production
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
ATTACHMENT_URL_SECRET=
# One-off code the first-time setup page asks for, so nobody else can claim the new server.
SETUP_TOKEN=

# --- Behind Cloudflare (set by docker-compose.prod.yml; listed for reference) ---
# COOKIE_SECURE=true
# TRUST_PROXY_HEADERS=true
# CLIENT_IP_HEADER=cf-connecting-ip
# FRONTEND_BASE_URL=https://${HSE_HOSTNAME}

# --- Capacity: API processes. setup.sh sets this to (CPU cores - 1), at least 2. ---
WEB_CONCURRENCY=3

# --- Administrators allowed to permanently delete projects (comma-separated). ---
PROJECT_DELETE_EMAILS=

# --- Two-step verification (authenticator app) ---
MFA_REQUIRED_ROLES=hse_manager,admin
MFA_GRACE_DAYS=7
MFA_ISSUER=HSE Platform

PRIVACY_NOTICE_VERSION=PN-1.0

# --- Outgoing email (README "Sending email"). Empty SMTP_HOST = emails wait in the outbox. ---
# Microsoft 365 example: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURITY=starttls.
# Oracle Cloud blocks outbound port 25; use 587 or 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- AI assistant (optional). Empty = the assistant answers "AI unavailable". ---
ANTHROPIC_API_KEY=

# --- Licence (docs/LICENSING.md). Empty = unlimited. A key pasted on the Licence page wins. ---
LICENCE_KEY=

# --- Upload virus scanning (ClamAV container, about 1.5-3 GB RAM). ---
# To switch scanning off: set CLAMAV_HOST= (empty), remove `clamav` from COMPOSE_PROFILES, then
# run update.sh and `sudo docker compose rm -sf clamav` in /opt/hse. CLAMAV_FAIL_OPEN=true stores
# files unscanned while the scanner is down instead of refusing them.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_OPEN=false

# --- Backups (backup.sh, daily at 02:30 Asia/Riyadh) ---
BACKUP_DIR=/var/backups/hse
BACKUP_KEEP_DAYS=14
# Optional copy to Oracle Object Storage (GUIDE.md "Extra: off-server copy"). Leave empty to skip.
# A pre-authenticated request (PAR) URL of a bucket, with object read/write, ending in /o/
OCI_BACKUP_PAR_URL=
