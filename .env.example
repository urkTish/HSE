# Copy to .env for local development. Never commit .env or real secrets.

# --- Database (docker compose `db` service) ---
POSTGRES_USER=hse
POSTGRES_PASSWORD=hse
POSTGRES_DB=hse
# Used when running the backend outside docker:
DATABASE_URL=postgresql+psycopg://hse:hse@localhost:5432/hse
TEST_DATABASE_URL=postgresql+psycopg://hse:hse@localhost:5432/hse_test

# --- Backend ---
ENVIRONMENT=development
# >= 32 characters; generate a random value for any shared environment
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Set true behind HTTPS
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated emails allowed to permanently delete projects (D-265). Empty = nobody.
PROJECT_DELETE_EMAILS=
PRIVACY_NOTICE_VERSION=PN-1.0
# Field encryption (ID numbers, P2) and the worker-ID blind index (Phase 2, P2-2) use separate
# keys (>= 32 characters each); generate random values for any shared environment.
FIELD_ENCRYPTION_KEY=dev-only-field-key-change-me-dev-only-field-key
BLIND_INDEX_KEY=dev-only-blind-index-key-change-me-dev-only-blind-index

# --- Outgoing email (SMTP, any provider; README "Sending email") ---
# Empty SMTP_HOST = emails stay in the outbox (email_outbox) and are not sent.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none (local relay only)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# e.g. HSE Platform <hse@client.sa>
SMTP_FROM=
# Optional tuning (defaults shown)
# EMAIL_MAX_ATTEMPTS=6
# EMAIL_RETRY_BASE_SECONDS=60
# EMAIL_MAX_AGE_HOURS=72
# EMAIL_BATCH_SIZE=50
# SMTP_TIMEOUT_SECONDS=30

# Seed password for all demo users created by `uv run python -m app.seed` (dev only)
SEED_PASSWORD=Demo-Passw0rd!2026

# --- Object storage (MinIO locally; used from Phase 1) ---
MINIO_ROOT_USER=hse-minio
MINIO_ROOT_PASSWORD=hse-minio-dev-secret
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=hse-files

# --- Frontend ---
BACKEND_URL=http://localhost:8000
